{
  "name": "shelfos",
  "private": true,
  "version": "1.0.0",
  "description": "Modern grocery and inventory management system for supermarkets and suppliers",
  "author": "ShelfOS Team",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "vite build && electron .",
    "electron:build": "vite build && electron-builder",
    "electron:build:mac": "vite build && electron-builder --mac",
    "electron:build:win": "vite build && electron-builder --win",
    "electron:build:linux": "vite build && electron-builder --linux"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.10",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "vite": "^8.0.10"
  },
  "build": {
    "appId": "com.shelfos.app",
    "productName": "ShelfOS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "public/**/*"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/shelfos_logo.svg"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/shelfos_logo.svg"
    },
    "linux": {
      "category": "Office",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "icon": "public/shelfos_logo.svg"
    }
  }
}
